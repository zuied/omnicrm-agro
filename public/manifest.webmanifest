{
  "name": "OmniCRM Agro & Equipment",
  "short_name": "OmniCRM Agro",
  "description": "Sistem CRM agro & alat pertanian untuk distributor, perkebunan, dan petani.",
  "id": "/app",
  "start_url": "/app",
  "display": "standalone",
  "background_color": "#f1f5f9",
  "theme_color": "#047857",
  "orientation": "portrait-primary",
  "icons": [
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "scope": "/",
  "share_target": {
    "action": "/app/demplot",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}